diff --git a/hw/eos/cams/70D/jp57_research.c b/hw/eos/cams/70D/jp57_research.c
new file mode 100644
--- /dev/null
+++ b/hw/eos/cams/70D/jp57_research.c
@@ -0,0 +1,94 @@
+/* Local 70D.112 QEMU research, not camera code. */
+#include "qemu/osdep.h"
+#include "hw/eos/eos.h"
+#include "hw/eos/model_list.h"
+#include "hw/eos/capture.h"
+
+static uint32_t regs[1024];
+static int started;
+static int done;
+static uint8_t *stream;
+static size_t stream_size, stream_pos;
+int mirror_lj14_encode(const uint16_t*,uint32_t,uint32_t,uint8_t**,size_t*);
+static int enabled(void)
+{
+    return eos_state->model->capture && eos_state->model->capture->jp57_research;
+}
+int capture_jp57_mmio(unsigned off, unsigned type, unsigned value, unsigned *ret)
+{
+    if (!enabled()) return 0;
+    if (off >= sizeof(regs) || (off & 3)) return 0;
+    if (type & MODE_WRITE) {
+        regs[off / 4] = value;
+        if (off == 0) {
+            started = !!(value & 1);done=0;
+            if (!started) { free(stream);stream=NULL;stream_size=stream_pos=0; }
+            else if ((regs[1]&15)==7) { done=1;started=0; }
+        }
+        if (off == 0x44 && (value & 0x400)) done=0;
+    }
+    *ret = regs[off / 4];
+    if (off == 0) *ret = 0x1010000 | (started&&!done);
+    if (off == 0x30) *ret = 0x1ff;
+    if (off == 0x44) *ret = done?0x400:0;
+    if (off == 0x24 && !(type & MODE_WRITE)) *ret = stream_size;
+    static unsigned last[1024];static uint8_t seen[1024];
+    if (off < 0x100 && ((type & MODE_WRITE)||!seen[off/4]||last[off/4]!=*ret))
+        fprintf(stderr,"[JP57R] %c %04X value=%08X ret=%08X pc=%08X\n", (type & MODE_WRITE)?'W':'R',off,value,*ret,CURRENT_CPU->env.regs[15]);
+    last[off/4]=*ret;seen[off/4]=1;
+    return 1;
+}
+int capture_jp57_pending(int conn)
+{
+    return enabled() && conn == 45 && (!stream || stream_pos>=stream_size);
+}
+static uint16_t raw14(const uint8_t *data,size_t bytes,size_t index)
+{
+    size_t bit=index*14,word=bit/16,off=bit%16;
+    size_t pos=word*2;
+    uint32_t a=data[pos]|data[pos+1]<<8,b=0;
+    if(pos+3<bytes)b=data[pos+2]|data[pos+3]<<8;
+    return (((a<<16)|b)>>(18-off))&16383;
+}
+int capture_jp57_input(int conn, const void *data, int size)
+{
+    if (!enabled() || !started || conn!=1 || stream) return 0;
+    fprintf(stderr,"[JP57R] input conn=%d bytes=%d frame=%08X components=%08X\n",conn,size,regs[0x80/4],regs[0x84/4]);
+    unsigned width=regs[0x80/4]&65535,height=regs[0x80/4]>>16;
+    if(!width||!height||width>3000||height>4000||regs[0x84/4]!=0x20e||(regs[1]&15)!=2) return 0;
+    size_t plane=(size_t)width*height,count=plane*2;
+    if((size_t)size!=count*14/8) { fprintf(stderr,"[JP57R] incomplete or unsupported input geometry\n");return 0; }
+    uint16_t *pixels=malloc(count*2);assert(pixels);
+    /* Preserve the DMA sequence: all left-half rows, then all right-half
+     * rows. Canon's CR2 c640 tag describes two 2784-wide slices. The JPEG
+     * components take adjacent values from that sequence; interleaving
+     * corresponding left/right pixels corrupts the decoded CR2 ordering. */
+    for(size_t i=0;i<count;i++)pixels[i]=raw14(data,size,i);
+    int result=mirror_lj14_encode(pixels,width*2,height,&stream,&stream_size);
+    fprintf(stderr,"[JP57R] encode result=%d size=%zu, DMA slice order preserved\n",result,stream_size);
+    const char *dir=getenv("QEMU_EOS_JP57_CAPTURE_DIR");
+    if(dir) {
+        char path[512];snprintf(path,sizeof(path),"%s/jp57-input.u16",dir);
+        FILE *f=fopen(path,"wb");if(f){fwrite(pixels,2,count,f);fclose(f);}
+        snprintf(path,sizeof(path),"%s/jp57-output.ljpeg",dir);
+        f=fopen(path,"wb");if(f&&stream){fwrite(stream,1,stream_size,f);}if(f)fclose(f);
+        snprintf(path,sizeof(path),"%s/jp57-layout.json",dir);
+        f=fopen(path,"w");if(f){fputs("{\"input_order\":\"dma-slices\",\"slices\":2,\"slice_width\":2784,\"height\":3708}\n",f);fclose(f);}
+    }
+    free(pixels);
+    return result==0;
+}
+int capture_jp57_fill(int conn,void *data,int size)
+{
+    if(!enabled()||conn!=45||!stream||stream_pos>=stream_size)return 0;
+    size_t n=MIN((size_t)size,stream_size-stream_pos);
+    memset(data,0,size);memcpy(data,stream+stream_pos,n);stream_pos+=n;
+    fprintf(stderr,"[JP57R] output %zu/%zu bytes, requested %d\n",stream_pos,stream_size,size);
+    return 1;
+}
+void capture_jp57_output_progress(int conn,int delay)
+{
+    if(!enabled()||conn!=45||!stream||stream_pos<stream_size||done)return;
+    done=1;
+    eos_trigger_int_after_progress(0xa3,delay+4);
+}
diff --git a/hw/eos/cams/70D/lossless14.c b/hw/eos/cams/70D/lossless14.c
new file mode 100644
--- /dev/null
+++ b/hw/eos/cams/70D/lossless14.c
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Bounded reference encoder for QEMU research, not a camera module.
+ * ITU T.81 Annex H: SOF3, two components, predictor 1, 14-bit samples.
+ * https://www.w3.org/Graphics/JPEG/itu-t81.pdf
+ */
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+
+int mirror_lj14_encode(const uint16_t*,uint32_t,uint32_t,uint8_t**,size_t*);
+
+typedef struct { uint8_t *p; size_t n,cap,limit; uint32_t bits; unsigned used; int failed; } writer;
+static void byte(writer *w, unsigned v)
+{
+    if (w->failed) return;
+    if (w->n==w->cap) {
+        size_t cap=w->cap?w->cap*2:4096;
+        if (cap>w->limit) cap=w->limit;
+        if (cap<=w->n) { w->failed=1;return; }
+        void *p=realloc(w->p,cap);
+        if (!p) { w->failed=1;return; }
+        w->p=p;w->cap=cap;
+    }
+    w->p[w->n++]=(uint8_t)v;
+}
+static void word(writer *w, unsigned v) { byte(w,v>>8);byte(w,v); }
+static void marker(writer *w, unsigned v) { byte(w,255);byte(w,v); }
+static void bits(writer *w, unsigned v, unsigned n)
+{
+    while (n--) {
+        w->bits=(w->bits<<1)|((v>>n)&1u);
+        if (++w->used==8) {
+            byte(w,w->bits);
+            if ((w->bits&255)==255) byte(w,0);
+            w->bits=w->used=0;
+        }
+    }
+}
+int mirror_lj14_encode(const uint16_t *pixels,uint32_t width,uint32_t height,uint8_t **out,size_t *size)
+{
+    if (!out||!size) return -1;
+    *out=NULL;*size=0;
+    if (!pixels||!width||width%2||width>131070||!height||height>65535) return -1;
+    if (height>24000000u/width) return -1;
+    size_t count=(size_t)width*height;
+    writer w={.limit=count*5+512};
+    marker(&w,0xd8);
+    marker(&w,0xc4);word(&w,34);byte(&w,0);
+    for (unsigned i=1;i<=16;i++) byte(&w,i==5?15:0);
+    for (unsigned i=0;i<15;i++) byte(&w,i);
+    marker(&w,0xc3);word(&w,14);byte(&w,14);word(&w,height);word(&w,width/2);byte(&w,2);
+    for (unsigned i=1;i<=2;i++) { byte(&w,i);byte(&w,0x11);byte(&w,0); }
+    marker(&w,0xda);word(&w,10);byte(&w,2);
+    for (unsigned i=1;i<=2;i++) { byte(&w,i);byte(&w,0); }
+    byte(&w,1);byte(&w,0);byte(&w,0);
+    for (uint32_t y=0;y<height;y++) {
+        for (uint32_t x=0;x<width;x++) {
+            size_t i=(size_t)y*width+x;
+            unsigned value=pixels[i];
+            if (value>16383) { free(w.p);return -1; }
+            int prediction=x>=2?pixels[i-2]:y?pixels[i-width]:8192;
+            int diff=(int)value-prediction;
+            unsigned mag=diff<0?-diff:diff,category=0;
+            for (unsigned m=mag;m;m>>=1) category++;
+            bits(&w,category,5);
+            if (category) bits(&w,diff<0?diff+((1u<<category)-1u):(unsigned)diff,category);
+        }
+    }
+    if (w.used) bits(&w,(1u<<(8-w.used))-1,8-w.used);
+    marker(&w,0xd9);
+    if (w.failed) { free(w.p);return -1; }
+    *out=w.p;*size=w.n;
+    return 0;
+}
diff --git a/hw/eos/cams/70D/eeko_lcd_research.inc.c b/hw/eos/cams/70D/eeko_lcd_research.inc.c
new file mode 100644
--- /dev/null
+++ b/hw/eos/cams/70D/eeko_lcd_research.inc.c
@@ -0,0 +1,122 @@
+/* Included by capture.c after make_jpeg(). Local 70D.112 emulator research.
+ * Main: ff41e6b8/ff41e9fc. Eeko ROM: ffb73894..ffb739c6,
+ * ffb6d33e (5472 x 3648), ffb6cb6c (length/status completion).
+ * This supplies a flat synthetic JPEG, not Eeko's RAW development or colour.
+ */
+#ifndef MIRROR_EEKO_LCD_HOST_TEST
+#include "hw/eos/eeko.h"
+#endif
+
+int capture_70d_eeko_lcd(const struct eeko_msg *, struct eeko_msg *);
+
+static struct {
+    uint32_t list, nested, count, chunks[16][2];
+    int ready;
+} lcd70;
+static struct {
+    uint32_t list, address, capacity;
+    int ready;
+} thm70;
+
+static int lcd70_ram(uint32_t address, uint32_t bytes)
+{
+    return address >= 0x100000 && address < 0x20000000 &&
+           bytes && bytes <= 0x20000000 - address;
+}
+
+static int lcd70_pool(uint32_t address, uint32_t bytes)
+{
+    uint32_t region[2];
+    eos_mem_read(0x01f80028, region, sizeof(region));
+    region[0] &= ~CACHING_BIT;
+    return lcd70_ram(region[0], region[1]) && address >= region[0] + 4 &&
+           address < region[0] + region[1] &&
+           bytes <= region[0] + region[1] - address;
+}
+
+int capture_70d_eeko_lcd(const struct eeko_msg *req, struct eeko_msg *out)
+{
+    if (req->ch >= 2 || req->cmd != EEKO_SS) return 0;
+    /* Thumbnail: main ff41dec4/ff41e04c; Eeko ffb737d8..ffb73870.
+     * C00 sets DMA handles, C01 supplies parameters/chunks, C03 starts;
+     * completion is C01 with {JPEG length, status, reserved}.
+     * The first placeholder uses a 160x120 DCF thumbnail; its physical
+     * development/resizing is not emulated. */
+    if (req->param == 0xc01) {
+        uint32_t box[8], chunk[2], address = req->arg & ~CACHING_BIT;
+        thm70.ready = 0;
+        if (!lcd70_pool(address, sizeof(box))) return 0;
+        eos_mem_read(address, box, sizeof(box));
+        if (box[0] || box[1] || box[2] || box[6] != 1 ||
+            !lcd70_pool(box[7], sizeof(chunk))) return 0;
+        eos_mem_read(box[7], chunk, sizeof(chunk)); chunk[0] &= ~CACHING_BIT;
+        if (!lcd70_ram(chunk[0], chunk[1]) || chunk[1] != 65536) return 0;
+        thm70.list = box[7]; thm70.address = chunk[0];
+        thm70.capacity = chunk[1]; thm70.ready = 1;
+        fprintf(stderr, "[LCD70R] captured C01: bounded thumbnail output chunk\n");
+        return 0;
+    }
+    if (req->param == 0xc03 && thm70.ready) {
+        thm70.ready = 0;
+        if (!lcd70_ram(req->arg & ~CACHING_BIT, 2)) return 0;
+        make_jpeg(160, 120, 128);
+        if (!cap.jpeg || cap.jpeg_len <= 0 || (unsigned)cap.jpeg_len > thm70.capacity) return 0;
+        uint32_t result[] = {cap.jpeg_len, 0, 0};
+        uint32_t reply = eeko_box(result, ARRAY_SIZE(result));
+        if (!reply) return 0;
+        eos_mem_write(thm70.address, cap.jpeg, cap.jpeg_len);
+        eeko_free(thm70.list);
+        out[0] = (struct eeko_msg){.ch = 3, .cmd = EEKO_SS, .param = 0xc01, .arg = reply};
+        fprintf(stderr, "[LCD70R] synthetic flat thumbnail 160x120: %d bytes\n", cap.jpeg_len);
+        return 1;
+    }
+    if (req->param == 0xb00) {
+        uint32_t box[33], address = req->arg & ~CACHING_BIT;
+        lcd70.ready = 0;
+        if (!lcd70_pool(address, sizeof(box))) return 0;
+        eos_mem_read(address, box, sizeof(box));
+        /* Restrict this first experiment to the one observed full-RAW job. */
+        const uint32_t prefix[] = {2, 1, 1, 1, 0, 3};
+        if (memcmp(box, prefix, sizeof(prefix)) ||
+            !box[6] || box[6] > ARRAY_SIZE(lcd70.chunks) ||
+            !lcd70_pool(box[7], box[6] * 8) ||
+            !lcd70_pool(box[32], 4)) {
+            fprintf(stderr, "[LCD70R] unsupported B00 parameters; no completion\n");
+            return 0;
+        }
+        eos_mem_read(box[7], lcd70.chunks, box[6] * 8);
+        for (unsigned i = 0; i < box[6]; i++) {
+            lcd70.chunks[i][0] &= ~CACHING_BIT;
+            uint32_t a = lcd70.chunks[i][0], n = lcd70.chunks[i][1];
+            if (!lcd70_ram(a, n) || n > 16 * 1024 * 1024) return 0;
+            for (unsigned j = 0; j < i; j++) {
+                uint32_t b = lcd70.chunks[j][0], m = lcd70.chunks[j][1];
+                if (a < b + m && b < a + n) return 0;
+            }
+        }
+        lcd70.list = box[7]; lcd70.nested = box[32]; lcd70.count = box[6]; lcd70.ready = 1;
+        fprintf(stderr, "[LCD70R] captured B00: %u bounded JPEG output chunks\n", lcd70.count);
+        return 0; /* B00 configures; it does not receive an acknowledgement. */
+    }
+    if (req->param != 0xb01 || !lcd70.ready) return 0;
+    lcd70.ready = 0;
+    if (!lcd70_ram(req->arg & ~CACHING_BIT, 2)) return 0;
+    make_jpeg(5472, 3648, 128);
+    size_t capacity = 0;
+    for (unsigned i = 0; i < lcd70.count; i++) capacity += lcd70.chunks[i][1];
+    if (!cap.jpeg || cap.jpeg_len <= 0 || (size_t)cap.jpeg_len > capacity) return 0;
+    uint32_t result[] = {cap.jpeg_len, 0, 0};
+    uint32_t reply = eeko_box(result, ARRAY_SIZE(result));
+    if (!reply) return 0;
+    size_t written = 0;
+    for (unsigned i = 0; i < lcd70.count && written < (size_t)cap.jpeg_len; i++) {
+        size_t n = MIN((size_t)lcd70.chunks[i][1], (size_t)cap.jpeg_len - written);
+        eos_mem_write(lcd70.chunks[i][0], cap.jpeg + written, n);
+        written += n;
+    }
+    eeko_free(lcd70.list); eeko_free(lcd70.nested);
+    out[0] = (struct eeko_msg){.ch = 3, .cmd = EEKO_SS, .param = 0xb03, .arg = reply};
+    fprintf(stderr, "[LCD70R] synthetic flat JPEG 5472x3648: %d bytes, B03 result %08X\n",
+            cap.jpeg_len, reply);
+    return 1;
+}
diff --git a/hw/eos/cams/70D/fencing_research.inc.c b/hw/eos/cams/70D/fencing_research.inc.c
new file mode 100644
--- /dev/null
+++ b/hw/eos/cams/70D/fencing_research.inc.c
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * 70D.112 completion-only model for the observed FB/FC preprocessing path.
+ * No image processing is modeled here. Existing dummy FB output is unchanged.
+ * ROM ff42e134 / ff42e0d0 are registered on interrupts D0 / D1. Start writes
+ * come from ff2c1b1c (B300=1) and ff2c1b4c (B340=8). Both require completed
+ * connection-14 DMA with the exact observed geometry, flags and pointer.
+ * Explicit research opt-in; never changes module clocks or shutter deadlines.
+ */
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+static struct {
+    uint32_t input, output, geometry, reserved;
+    int fb_pending, fc_pending, fb_done;
+} fencing70;
+
+static int fencing70_enabled(void)
+{
+    const char*enabled=getenv("QEMU_EOS_FENCING_RESEARCH");
+    return enabled&&!strcmp(enabled,"1")&&eos_state->model->capture&&
+        eos_state->model->capture->jp57_research&&!strcmp(eos_state->model->name,"70D")&&
+        eos_state->model->firmware_version==112&&eos_state->model->digic_version==5;
+}
+static int fencing70_ram(uint32_t a,uint32_t n)
+{return a>=0x100000&&a<0x20000000&&n&&n<=0x20000000-a;}
+static int fencing70_offsets(const EDmacChState*c)
+{return !c->ya&&!c->yb&&!c->yn&&!c->off1a&&!c->off1b&&!c->off2a&&!c->off2b&&!c->off3;}
+static void fencing70_consume(unsigned irq)
+{
+    /* engine.c schedules the input DMA IRQ at floor(bytes/rate/256us)+1.
+     * Its host buffer/pointer advance before that IRQ fires. Completion must
+     * follow the DMA IRQ, or Canon unregisters its handler too early. */
+    uint32_t bytes=eos_state->edmac.conn_data[14].data_size;
+    unsigned delay=(unsigned)((uint64_t)bytes*1000000/(200*1024*1024)/256)+2;
+    free(eos_state->edmac.conn_data[14].buf);
+    eos_state->edmac.conn_data[14].buf=NULL;eos_state->edmac.conn_data[14].data_size=0;
+    eos_trigger_int(irq,delay);
+    fprintf(stderr,"[FENCE70R] bounded synthetic preprocessing completion IRQ %X after %u DMA ticks\n",irq,delay);
+}
+static void fencing70_poll(void)
+{
+    if(!fencing70_enabled()||eos_state->edmac.read_conn[14]!=12)return;
+    const EDmacChState*r=&eos_state->edmac.ch[12],*w=&eos_state->edmac.ch[16];
+    const EDmacData*data=&eos_state->edmac.conn_data[14];
+    if(!data->buf||r->flags!=0x40050000||!fencing70_offsets(r))return;
+    if(fencing70.fb_pending&&fencing70.geometry==0x00f00140&&!fencing70.reserved&&
+       fencing70_ram(fencing70.input,168064)&&fencing70_ram(fencing70.output,54000)&&
+       r->xa==4096&&r->xb==128&&r->xn==41&&data->data_size==168064&&r->addr==fencing70.input+168064&&
+       /* Canon's completed write ISR has cleared its flags by block start. */
+       eos_state->edmac.write_conn[16]==23&&!w->flags&&fencing70_offsets(w)&&
+       w->xa==4096&&w->xb==752&&w->xn==13&&w->addr==fencing70.output+54000){
+        fencing70.fb_pending=0;fencing70.fb_done=1;fencing70_consume(0xd0);
+    }else if(fencing70.fc_pending&&fencing70.fb_done&&
+        fencing70_ram(fencing70.output,0x1000000)&&r->xa==4096&&!r->xb&&r->xn==4096&&
+        data->data_size==0x1000000&&r->addr==fencing70.output+0x1000000){
+        fencing70.fc_pending=fencing70.fb_done=0;fencing70_consume(0xd1);
+    }
+}
+static void fencing70_mmio(uint32_t address,unsigned type,uint32_t value)
+{
+    if(!(type&MODE_WRITE)||!fencing70_enabled())return;
+    switch(address){
+        case 0xc0f1b330:fencing70.input=value;break;
+        case 0xc0f1b334:fencing70.output=value;break;
+        case 0xc0f1b338:fencing70.geometry=value;break;
+        case 0xc0f1b33c:fencing70.reserved=value;break;
+        case 0xc0f1b300:
+            fencing70.fb_pending=value==1;
+            if(!value)fencing70.fc_pending=fencing70.fb_done=0;
+            break;
+        case 0xc0f1b340:fencing70.fc_pending=value==8;break;
+        default:return;
+    }
+    fencing70_poll();
+}
