+++ b/hw/eos/model_list.c
@@ -1,6 +1,23 @@
 #include <stddef.h>
 #include "model_list.h"
 
+/* Local 70D.112 research: MPU release events ONLY. No sensor/compression model.
+ * ROM EventMgr at ff0f21c4 copies payload[0x37]+0x38 for event 2,
+ * payload[0x28]+0x29 for event 3. Zero extension selects the normal path.
+ * Exposure fields are an unverified experiment, not a camera-captured packet.
+ * This profile cannot establish a RAW write interval or hardware support. */
+#include "capture.h"
+static const struct capture_profile capture_70d_release_events = {
+    .release_data_len = 0x38,
+    .after_data_len = 0x29,
+    .release_gpio = 0xc02200a8, .release_bit = 2,
+    .init_release_line = 0x44,
+    .capready_irq = 0x51,
+    .vd_irq = -1,
+    .jpcore_conn = -1,
+    .init_tv = 0x68, .init_av = 0x30, .init_iso = 0x48,
+};
+
 /* Camera profiles (docs/models/PROFILES.md): each hw/eos/cams/<CAM>/ declares its hooks in profile.h
  * and holds its table entry in model.inc.c, included below at its place in the DIGIC group. */
 #include "cams/1100D/profile.h"
@@ -476,6 +493,7 @@ struct eos_model_desc eos_model_list[] = {
     },
     {
         .name                   = MODEL_NAME_70D,
+        .capture                = &capture_70d_release_events,
         .digic_version          = 5,
         .rom0_size              = 0x00800000,   /* 8MB */
         .ram_size               = 0x20000000,   /* 512MB */
